{
  "name": "LinuxCNC AI Laboratory",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "16gb"
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "bash .devcontainer/bootstrap.sh",
  "remoteEnv": {
    "LINUXCNC_SRC": "${containerWorkspaceFolder}/.lab/linuxcnc"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-python.python"
      ]
    }
  }
}
